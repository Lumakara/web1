# ============================================
# WEBSITE CONFIGURATION
# ============================================
VITE_SITE_NAME=Layanan Digital
VITE_SITE_DESCRIPTION="Solusi Digital untuk Kebutuhan Anda"
VITE_SITE_URL=https://your-domain.vercel.app
VITE_SITE_LOGO_URL=https://your-logo-url.svg

# Owner Information
VITE_OWNER_NAME=Your Name
VITE_OWNER_EMAIL=your@email.com
VITE_OWNER_PHONE=08123456789
VITE_OWNER_WHATSAPP=https://wa.me/6281234567890

# Social Media
VITE_INSTAGRAM_URL=https://instagram.com/yourusername
VITE_FACEBOOK_URL=https://facebook.com/yourusername
VITE_TWITTER_URL=https://twitter.com/yourusername

# ============================================
# 🔥 FIREBASE AUTHENTICATION (WAJIB)
# ============================================
# Dapatkan dari Firebase Console: https://console.firebase.google.com
# 1. Buat project baru
# 2. Buka Project Settings → General
# 3. Scroll ke "Your apps" section
# 4. Copy config values

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123def456

# ============================================
# SUPABASE CONFIGURATION (TIDAK DIGUNAKAN UNTUK AUTH)
# ============================================
# Supabase masih digunakan untuk data lain jika diperlukan
# Tapi TIDAK untuk authentication
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# EMAILJS CONFIGURATION (OPSIONAL)
# Untuk notifikasi email
# ============================================
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ============================================
# PAKASIR PAYMENT GATEWAY (OPSIONAL)
# ============================================
VITE_PAKASIR_SLUG=your_pakasir_slug
VITE_PAKASIR_API_KEY=your_pakasir_api_key

# ============================================
# PTERODACTYL PANEL CONFIGURATION (OPSIONAL)
# ============================================
VITE_PTERODACTYL_API_URL=https://your-panel.com
VITE_PTERODACTYL_API_KEY=your_api_key
VITE_PTERODACTYL_CLIENT_API_KEY=your_client_api_key
VITE_PTERODACTYL_NODE_ID=1
VITE_PTERODACTYL_LOCATION_ID=1
VITE_PTERODACTYL_EGG_ID=1
VITE_PTERODACTYL_NEST_ID=1

# ============================================
# OPENAI CONFIGURATION (OPSIONAL)
# Untuk AI Chat di halaman Support
# ============================================
VITE_OPENAI_API_KEY=your_openai_api_key
VITE_OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# TELEGRAM BOT CONFIGURATION (OPSIONAL)
# Untuk notifikasi Telegram
# ============================================
VITE_TELEGRAM_BOT_TOKEN=your_bot_token:token
VITE_TELEGRAM_CHAT_ID=your_chat_id

# ============================================
# FEATURE FLAGS
# ============================================
VITE_ENABLE_PAYMENT=true
VITE_ENABLE_LIVE_CHAT=true
VITE_ENABLE_PTERODACTYL=true
VITE_ENABLE_WIFI_INSTALLATION=true
VITE_ENABLE_EMAIL_NOTIFICATIONS=true

# Development settings
VITE_DEBUG_MODE=true
VITE_MOCK_PAYMENT=true
